function chatRender() {
  $('#panel-body').innerHTML = `<div class="chat-box" id="chat-box">${chats.map((c) => `<div>${c.ghost ? '👻' : c.emoji} <b>${esc(c.name)}</b>${c.scope === 'ally' ? ' <small>(동맹)</small>' : ''}: ${esc(c.text)}</div>`).join('') || '<div class="sub">아직 대화가 없어요</div>'}</div>
  <div class="chat-send"><select id="chat-scope"><option value="all">전체</option><option value="ally">동맹</option></select><input id="chat-inp" maxlength="80" placeholder="메시지..." autocomplete="off"><button class="ib pink" data-ui="chat-send">보내기</button></div>`;
  const b = $('#chat-box'); if (b) b.scrollTop = b.scrollHeight;
}
function sendChat() {
  const i = $('#chat-inp'); if (!i) return;
  const text = i.value.trim(); if (!text) return;
  socket.emit('chat', { text, scope: $('#chat-scope').value });
  i.value = '';
}

function readBundle(attr) {
  const o = {};
  document.querySelectorAll(`[data-${attr}]`).forEach((el) => { o[el.dataset[attr]] = Math.max(0, Math.min(50, Math.floor(Number(el.value) || 0))); });
  return o;
}

function onUIClick(e) {
  const el = e.target.closest('[data-ui],[data-close]');
  if (!el) return;
  if (el.dataset.close) return closePanel();
  const d = el.dataset;
  switch (d.ui) {
    case 'eat': act('eat'); break;
    case 'shield': act('shield'); break;
    case 'trap': act('trap'); break;
    case 'craft': act('craft', { item: d.item }); break;
    case 'deposit': act('deposit', { res: d.res, n: Number(d.n) }); break;
    case 'exchange': act('exchange', { from: $('#ex-from').value, to: $('#ex-to').value }); break;
    case 'ally-req': act('allyReq', { to: d.to }); break;
    case 'ally-break': act('allyBreak', { to: d.to }); break;
    case 'hook': act('hook', { to: d.to }); break;
    case 'trade-open': openPanel('trade', d.to); break;
    case 'betray-open': openPanel('betray', d.to); break;
    case 'trade-send': act('trade', { to: d.to, give: readBundle('give'), want: readBundle('want') }); closePanel(); break;
    case 'trade-yes': act('tradeReply', { id: d.id, accept: true }); reqs = reqs.filter((r) => r.id !== d.id); renderReqs(); break;
    case 'trade-no': act('tradeReply', { id: d.id, accept: false }); reqs = reqs.filter((r) => r.id !== d.id); renderReqs(); break;
    case 'ally-yes': act('allyReply', { from: d.from, accept: true }); reqs = reqs.filter((r) => !(r.kind === 'ally' && r.from === d.from)); renderReqs(); break;
    case 'ally-no': act('allyReply', { from: d.from, accept: false }); reqs = reqs.filter((r) => !(r.kind === 'ally' && r.from === d.from)); renderReqs(); break;
    case 'chat-send': sendChat(); break;
    default: break;
  }
}

