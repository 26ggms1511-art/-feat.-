'use strict';
// ============================================================
//  친구 배신 게임 - 클라이언트 (그리기 / 조작 / UI)
//  게임 규칙과 점수는 전부 서버가 계산한다. 여기서는 보여주기만 함.
// ============================================================
(() => {
const $ = (s) => document.querySelector(s);
const socket = io();

const RES = ['wood', 'stone', 'food', 'part', 'gem'];
const RE = { wood: '🪵', stone: '🪨', food: '🍎', part: '⚙️', gem: '💎' };
const RN = { wood: '나무', stone: '돌', food: '음식', part: '부품', gem: '보석' };
const NODE_E = { wood: '🌳', stone: '🪨', food: '🍎', part: '⚙️', gem: '💎', chest: '🎁' };
const ZONE_COLOR = { forest: '#9fe08c', mine: '#cdcdda', beach: '#fbe7a6', ruins: '#dcc7ec', hazard: '#ffa684' };
const ITEM_KEYS = ['axe', 'armor', 'shield', 'trap', 'hook'];

let session = null;
try { session = JSON.parse(sessionStorage.getItem('betray-session') || 'null'); } catch (e) { session = null; }
let pid = session ? session.pid : null;
let cfg = null, S = null, nodes = [], lobby = null, playing = false;
let results = null;
const pos = new Map();
let reqs = [];
let logs = [];
let chats = [];
let panel = null, panelData = null, panelSig = '';
let specPid = null;
const cam = { x: 900, y: 600 };

// ---------- 화면 전환 ----------
function screen(name) {
  for (const el of document.querySelectorAll('.screen')) el.classList.toggle('hidden', el.id !== 'screen-' + name);
}
function saveSession(s) {
  session = s; pid = s ? s.pid : null;
  try { if (s) sessionStorage.setItem('betray-session', JSON.stringify(s)); else sessionStorage.removeItem('betray-session'); } catch (e) { /* ignore */ }
}
function msg(t) { $('#menu-msg').textContent = t || ''; }
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

// ---------- 메뉴 ----------
try { $('#inp-name').value = localStorage.getItem('betray-name') || ''; } catch (e) { /* ignore */ }
const qRoom = new URLSearchParams(location.search).get('room');
if (qRoom) $('#inp-code').value = qRoom.toUpperCase().slice(0, 5);

function getName() {
  const n = $('#inp-name').value.trim();
  if (!n) { msg('이름을 먼저 입력해줘!'); return null; }
  try { localStorage.setItem('betray-name', n); } catch (e) { /* ignore */ }
  return n;
}
function onJoined(res) {
  if (!res || !res.ok) return msg((res && res.error) || '연결에 실패했어. 다시 시도해줘!');
  saveSession({ code: res.code, pid: res.pid, token: res.token });
  msg('');
}
$('#btn-create').onclick = () => { const name = getName(); if (name) socket.emit('create', { name }, onJoined); };
$('#btn-join').onclick = () => {
  const name = getName(); if (!name) return;
  const code = $('#inp-code').value.trim().toUpperCase();
  if (code.length < 5) return msg('방 코드 5자리를 입력해줘!');
  socket.emit('join', { name, code }, onJoined);
};
$('#btn-leave').onclick = leave;
$('#btn-end-leave').onclick = leave;
function leave() {
  socket.emit('leave');
  saveSession(null); playing = false; S = null; results = null; lobby = null;
  screen('menu');
}
$('#btn-start').onclick = () => socket.emit('start');
$('#btn-rematch').onclick = () => socket.emit('rematch');
$('#btn-copy').onclick = async () => {
  if (!lobby) return;
  const url = `${location.origin}/?room=${lobby.code}`;
  const text = `친구 배신 게임 같이 하자! 방 코드: ${lobby.code}\n${url}`;
  try {
    if (navigator.share) { await navigator.share({ title: '친구 배신 게임', text, url }); return; }
  } catch (e) { /* 공유 취소 */ }
  try { await navigator.clipboard.writeText(text); $('#lobby-msg').textContent = '초대 링크를 복사했어! 친구에게 보내줘 👍'; }
  catch (e) { $('#lobby-msg').textContent = `링크: ${url}`; }
};

// ---------- 소켓 이벤트 ----------
socket.on('connect', () => {
  if (session) {
    socket.emit('rejoin', session, (res) => {
      if (!res || !res.ok) { saveSession(null); playing = false; screen('menu'); }
    });
  }
});
socket.on('kicked', () => { saveSession(null); playing = false; screen('menu'); msg('다른 화면에서 접속해서 이 화면은 종료됐어.'); });
socket.on('lobby', (d) => {
  lobby = d; playing = false; results = null; closePanel();
  screen('lobby');
  $('#lobby-code').textContent = d.code;
  $('#lobby-count').textContent = `(${d.players.length}/8)`;
  $('#lobby-list').innerHTML = d.players.map((p) =>
    `<li class="${p.on ? '' : 'off'}">${p.emoji} ${esc(p.name)} ${p.pid === d.host ? '👑' : ''} ${p.pid === pid ? '(나)' : ''}${p.on ? '' : ' 💤'}</li>`).join('');
  const isHost = d.host === pid;
  $('#btn-start').classList.toggle('hidden', !isHost);
  $('#lobby-wait').classList.toggle('hidden', isHost);
  $('#btn-start').disabled = d.players.filter((p) => p.on).length < 2;
  $('#btn-start').textContent = $('#btn-start').disabled ? '2명 이상 모여야 시작해요' : '▶ 게임 시작';
});
socket.on('started', (c) => {
  cfg = c; playing = true; results = null; reqs = []; logs = []; chats = []; pos.clear(); S = null; specPid = null;
  closePanel(); renderReqs();
  screen('game'); resize();
});
socket.on('nodes', (l) => { nodes = l; });
socket.on('state', onState);
socket.on('toast', (t) => showToast(t.text, t.kind));
socket.on('log', (l) => { pushLog(l.text, false); });
socket.on('chat', (c) => {
  chats.push(c); if (chats.length > 60) chats.shift();
  pushLog(`${c.ghost ? '👻' : c.emoji} ${c.name}${c.scope === 'ally' ? '(동맹)' : ''}: ${c.text}`, true);
  if (panel === 'chat') renderPanel(true);
});
socket.on('tradeReq', (r) => { reqs = reqs.filter((x) => x.id !== r.id); reqs.push({ kind: 'trade', id: r.id, from: r.from, name: r.name, emoji: r.emoji, give: r.give, want: r.want, at: Date.now() }); renderReqs(); buzz(); });
socket.on('tradeEnd', (r) => { reqs = reqs.filter((x) => x.id !== r.id); renderReqs(); });
socket.on('allyReq', (r) => { reqs = reqs.filter((x) => !(x.kind === 'ally' && x.from === r.from)); reqs.push({ kind: 'ally', id: 'a' + r.from, from: r.from, name: r.name, emoji: r.emoji, at: Date.now() }); renderReqs(); buzz(); });
socket.on('ended', (r) => { results = r; playing = false; closePanel(); showEnd(); });

function buzz() { try { if (navigator.vibrate) navigator.vibrate(60); } catch (e) { /* ignore */ } }

// ---------- 토스트/로그 ----------
function showToast(text, kind) {
  const d = document.createElement('div');
  d.className = 'toast ' + (kind || '');
  d.textContent = text;
  const box = $('#toasts');
  box.appendChild(d);
  while (box.children.length > 4) box.removeChild(box.firstChild);
  setTimeout(() => d.remove(), 3200);
}
function pushLog(text, isChat) {
  logs.push({ text, isChat, at: Date.now() });
  if (logs.length > 30) logs.shift();
  renderLog();
}
function renderLog() {
  const now = Date.now();
  logs = logs.filter((l) => now - l.at < 12000);
  $('#log').innerHTML = logs.slice(-5).map((l) => `<div class="${l.isChat ? 'chat' : ''}">${esc(l.text)}</div>`).join('');
}
setInterval(() => { if (playing) renderLog(); }, 1500);

function renderReqs() {
  const now = Date.now();
  reqs = reqs.filter((r) => now - r.at < 30000);
  $('#reqs').innerHTML = reqs.map((r) => {
    if (r.kind === 'trade') {
      return `<div class="req">🔄 ${r.emoji} ${esc(r.name)} 의 거래 제안<br>줄게: ${bundleStr(r.give)}<br>받고 싶어: ${bundleStr(r.want)}
      <div class="rbtns"><button data-ui="trade-yes" data-id="${esc(r.id)}">수락</button><button class="no" data-ui="trade-no" data-id="${esc(r.id)}">거절</button></div></div>`;
    }
    return `<div class="req">🤝 ${r.emoji} ${esc(r.name)} 이(가) 동맹을 제안했어!
      <div class="rbtns"><button data-ui="ally-yes" data-from="${esc(r.from)}">수락</button><button class="no" data-ui="ally-no" data-from="${esc(r.from)}">거절</button></div></div>`;
  }).join('');
}
setInterval(() => { if (reqs.length) renderReqs(); }, 2000);
function bundleStr(b) { return RES.filter((k) => b[k] > 0).map((k) => `${RE[k]}${b[k]}`).join(' ') || '없음 (선물)'; }

// ---------- 상태 수신 ----------
function onState(s) {
  S = s;
  const seen = new Set();
  for (const p of s.players) {
    if (p.x === undefined) continue;
    seen.add(p.id);
    const q = pos.get(p.id);
    if (!q) pos.set(p.id, { x: p.x, y: p.y, tx: p.x, ty: p.y });
    else { q.tx = p.x; q.ty = p.y; }
  }
  for (const id of [...pos.keys()]) if (!seen.has(id)) pos.delete(id);
  updateHUD();
  if (panel) renderPanel(false);
}
const meP = () => (S ? S.players.find((p) => p.id === pid) : null);

function fmtTime(sec) { sec = Math.max(0, Math.ceil(sec)); return `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`; }
function updateHUD() {
  const m = S.me;
  $('#hp-fill').style.width = Math.max(0, m.hp) + '%';
  $('#hp-text').textContent = `❤️ ${m.hp}${m.shieldLeft ? ` 🔮${m.shieldLeft}s` : ''}`;
  $('#hud-phase').textContent = S.phase === 'night' ? '🌙' : '☀️';
  $('#hud-time').textContent = fmtTime(cfg.dur - S.t);
  $('#hud-code').textContent = session ? session.code : '';
  $('#hud-score').textContent = m.score;
  $('#hud-camp').textContent = S.camp.lv;
  $('#res-line').textContent = RES.map((k) => `${RE[k]}${m.inv[k]}`).join(' ');
  const eb = $('#event-banner');
  if (S.ev) { eb.classList.remove('hidden'); eb.textContent = `${S.ev.name} ${S.ev.left}s`; } else eb.classList.add('hidden');
  const si = $('#ship-info');
  if (S.ship.active && !S.ship.departed) { si.classList.remove('hidden'); si.textContent = `🚢 탈출선 ${S.ship.boarded}/${S.ship.seats}명 · ${S.ship.left}s`; }
  else si.classList.add('hidden');
  const dead = meP() && !meP().a;
  $('#btn-spec').classList.toggle('hidden', !dead);
  const c = ctxAction();
  const mb = $('#btn-main');
  mb.textContent = c.label; mb.classList.toggle('dim', !c.run);
}

// ---------- 컨텍스트 행동 버튼 ----------
const act = (type, extra) => socket.emit('act', Object.assign({ type }, extra || {}));
function myPos() { return pos.get(pid); }
function ctxAction() {
  const me = meP();
  if (!S || !me) return { label: '🖐 채집' };
  if (!me.a) return { label: '👻 관전 중' };
  if (me.bd) return { label: '⛵ 탑승 완료!' };
  const mp = myPos();
  if (!mp) return { label: '🖐 채집' };
  if (S.ship.active && !S.ship.departed && Math.hypot(mp.x - cfg.DOCK.x, mp.y - cfg.DOCK.y) <= 100) return { label: '⛵ 탑승하기', run: () => act('board') };
  let best = null, bd = 68;
  for (const n of nodes) { const d = Math.hypot(mp.x - n[2], mp.y - n[3]); if (d < bd) { bd = d; best = n; } }
  if (best) return { label: `${NODE_E[best[1]]} 채집하기`, run: () => act('collect') };
  if (Math.hypot(mp.x - cfg.CAMP.x, mp.y - cfg.CAMP.y) <= 150) return { label: '🏕️ 캠프 열기', run: () => openPanel('camp') };
  return { label: '🖐 채집 (자원 근처에서!)' };
}
$('#btn-main').addEventListener('pointerdown', (e) => { e.preventDefault(); const c = ctxAction(); if (c.run) c.run(); else showToast('자원 가까이로 이동해서 눌러봐!'); });

// ---------- 조작 ----------
const keys = {};
let joyV = { x: 0, y: 0 };
addEventListener('keydown', (e) => {
  if (e.target && e.target.tagName === 'INPUT') { if (e.key === 'Enter' && panel === 'chat') sendChat(); return; }
  const k = e.key.toLowerCase();
  keys[k] = true;
  if (!playing) return;
  if (k === 'e' || k === ' ') { e.preventDefault(); const c = ctxAction(); if (c.run) c.run(); }
  if (k === 'i') togglePanel('inv');
  if (k === 'p') togglePanel('players');
  if (k === 'c') togglePanel('camp');
  if (k === 'm') togglePanel('mission');
  if (k === 'enter') togglePanel('chat');
  if (k === 'escape') closePanel();
});
addEventListener('keyup', (e) => { keys[e.key.toLowerCase()] = false; });
addEventListener('blur', () => { for (const k in keys) keys[k] = false; });

const joy = $('#joy'), knob = $('#knob');
let joyId = null;
function joyMove(e) {
  const r = joy.getBoundingClientRect();
  const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
  let dx = (e.clientX - cx) / (r.width / 2), dy = (e.clientY - cy) / (r.height / 2);
  const len = Math.hypot(dx, dy);
  if (len > 1) { dx /= len; dy /= len; }
  joyV = { x: Math.abs(dx) < 0.12 ? 0 : dx, y: Math.abs(dy) < 0.12 ? 0 : dy };
  knob.style.transform = `translate(${dx * r.width * 0.32}px, ${dy * r.height * 0.32}px)`;
}
joy.addEventListener('pointerdown', (e) => { e.preventDefault(); joyId = e.pointerId; joy.setPointerCapture(e.pointerId); joyMove(e); });
joy.addEventListener('pointermove', (e) => { if (e.pointerId === joyId) joyMove(e); });
const joyEnd = (e) => { if (e.pointerId === joyId) { joyId = null; joyV = { x: 0, y: 0 }; knob.style.transform = ''; } };
joy.addEventListener('pointerup', joyEnd);
joy.addEventListener('pointercancel', joyEnd);

let lastSent = { x: 0, y: 0 }, lastSentAt = 0;
setInterval(() => {
  if (!playing || !S) return;
  let x = joyV.x, y = joyV.y;
  if (keys['a'] || keys['arrowleft']) x -= 1;
  if (keys['d'] || keys['arrowright']) x += 1;
  if (keys['w'] || keys['arrowup']) y -= 1;
  if (keys['s'] || keys['arrowdown']) y += 1;
  const len = Math.hypot(x, y);
  if (len > 1) { x /= len; y /= len; }
  x = Math.round(x * 100) / 100; y = Math.round(y * 100) / 100;
  const moving = x !== 0 || y !== 0;
  const changed = x !== lastSent.x || y !== lastSent.y;
  const now = Date.now();
  if (changed || (moving && now - lastSentAt > 200)) { socket.emit('input', { x, y }); lastSent = { x, y }; lastSentAt = now; }
}, 60);

// ---------- 패널 ----------
document.body.addEventListener('click', onUIClick);
document.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('pointerdown', (e) => { e.preventDefault(); togglePanel(b.dataset.open); }));
$('#btn-spec').addEventListener('pointerdown', (e) => {
  e.preventDefault();
  if (!S) return;
  const alive = S.players.filter((p) => p.a && p.x !== undefined);
  if (!alive.length) return;
  const i = alive.findIndex((p) => p.id === specPid);
  specPid = alive[(i + 1) % alive.length].id;
  showToast(`👁 ${alive[(i + 1) % alive.length].n} 관전 중`);
});
function togglePanel(name) { if (panel === name) closePanel(); else openPanel(name); }
function openPanel(name, data) { panel = name; panelData = data || null; panelSig = ''; $('#panel').classList.remove('hidden'); renderPanel(true); }
function closePanel() { panel = null; panelData = null; $('#panel').classList.add('hidden'); }

function renderPanel(force) {
  if (!panel || !S) return;
  const titles = { inv: '🎒 가방 · 만들기', players: '👥 친구들', camp: '🏕️ 캠프', mission: '🎯 비밀 미션', chat: '💬 채팅', trade: '🔄 거래 제안', betray: '😈 배신' };
  $('#panel-title').textContent = titles[panel] || '';
  let html = '';
  if (panel === 'inv') html = invHTML();
  else if (panel === 'players') html = playersHTML();
  else if (panel === 'camp') html = campHTML();
  else if (panel === 'mission') html = missionHTML();
  else if (panel === 'betray') html = betrayHTML();
  else if (panel === 'trade') { if (force) { $('#panel-body').innerHTML = tradeHTML(); } return; }
  else if (panel === 'chat') { if (force) { chatRender(); } return; }
  const body = $('#panel-body');
  if (force || html !== panelSig) { const st = body.scrollTop; body.innerHTML = html; body.scrollTop = st; panelSig = html; }
}

function invHTML() {
  const m = S.me, inv = m.inv;
  let h = `<div class="chips">${RES.map((k) => `<span class="chip">${RE[k]} ${RN[k]} ${inv[k]}</span>`).join('')}</div>`;
  h += `<h4>보유 아이템</h4><div class="chips">`;
  for (const k of ITEM_KEYS) { const r = cfg.recipes[k]; h += `<span class="chip ${inv[k] ? 'ok' : ''}">${r.emoji} ${r.name} ${inv[k]}</span>`; }
  h += `</div>`;
  h += `<div class="item-row"><div class="info"><b>🍎 음식 먹기</b><small>체력 +20 (음식 ${inv.food}개)</small></div><button class="ib green" data-ui="eat" ${inv.food < 1 || m.hp >= 100 ? 'disabled' : ''}>먹기</button></div>`;
  h += `<div class="item-row"><div class="info"><b>🔮 방어막 사용</b><small>25초간 피해·도난 방지 (${inv.shield}개)${m.shieldLeft ? ` · 남음 ${m.shieldLeft}s` : ''}</small></div><button class="ib" data-ui="shield" ${inv.shield < 1 ? 'disabled' : ''}>사용</button></div>`;
  h += `<div class="item-row"><div class="info"><b>🪤 함정 설치</b><small>지금 서 있는 곳에 설치 (${inv.trap}개) · 캠프 밖에서만</small></div><button class="ib" data-ui="trap" ${inv.trap < 1 ? 'disabled' : ''}>설치</button></div>`;
  h += `<h4>🔨 만들기</h4>`;
  for (const k of ITEM_KEYS) {
    const r = cfg.recipes[k];
    const enough = Object.keys(r.cost).every((x) => inv[x] >= r.cost[x]);
    const maxed = inv[k] >= r.max;
    const cost = Object.keys(r.cost).map((x) => `${RE[x]}${r.cost[x]}`).join(' ');
    h += `<div class="item-row"><div class="info"><b>${r.emoji} ${r.name}</b><small>${r.desc}</small><small>재료: ${cost}</small></div><button class="ib pink" data-ui="craft" data-item="${k}" ${!enough || maxed ? 'disabled' : ''}>${maxed ? '최대' : '만들기'}</button></div>`;
  }
  return h;
}

function playersHTML() {
  const me = meP();
  const alive = me && me.a && !me.bd;
  const mp = myPos();
  let h = '';
  const others = S.players.filter((p) => p.id !== pid);
  if (!others.length) return '<div class="sub">다른 플레이어가 없어요</div>';
  for (const p of others) {
    const q = pos.get(p.id);
    const near = !!(mp && q && Math.hypot(mp.x - q.x, mp.y - q.y) <= 110);
    const isAlly = S.me.allies.includes(p.id);
    const status = [!p.a ? '💀 탈락' : '', p.bd ? '⛵ 탑승' : '', p.bt ? `😈 배신자 ${p.bt}s` : '', isAlly ? '🤝 동맹' : '', !p.on ? '💤 오프라인' : ''].filter(Boolean).join(' · ');
    const can = alive && p.a && !p.bd;
    h += `<div class="item-row"><div class="info"><b>${p.e} ${esc(p.n)} <span class="mini-hp"><i style="width:${p.hp}%"></i></span></b><small>${status || '생존 중'}</small></div>`;
    if (can) {
      h += isAlly
        ? `<button class="ib" data-ui="ally-break" data-to="${p.id}">💔</button>`
        : `<button class="ib green" data-ui="ally-req" data-to="${p.id}">🤝</button>`;
      h += `<button class="ib" data-ui="trade-open" data-to="${p.id}">🔄</button>`;
      h += `<button class="ib red" data-ui="betray-open" data-to="${p.id}" data-near="${near ? 1 : 0}">😈</button>`;
    }
    h += `</div>`;
  }
  h += `<div class="sub">🤝 동맹 · 🔄 거래 · 😈 배신 메뉴</div>`;
  return h;
}

function betrayHTML() {
  const t = S.players.find((p) => p.id === panelData);
  if (!t) return '<div class="sub">상대를 찾을 수 없어요</div>';
  const mp = myPos(), q = pos.get(t.id);
  const near = !!(mp && q && Math.hypot(mp.x - q.x, mp.y - q.y) <= 105);
  const isAlly = S.me.allies.includes(t.id);
  const inv = S.me.inv;
  let h = `<div class="item-row"><div class="info"><b>${t.e} ${esc(t.n)}</b><small>${isAlly ? '🤝 동맹 중' : '동맹 아님'} · ${near ? '✅ 가까이 있음' : '❌ 너무 멀어 (갈고리는 가까이서만)'}</small></div></div>`;
  h += `<div class="item-row"><div class="info"><b>💔 동맹 해제</b><small>점수는 없지만 해제 직후 10초 안에 훔치면 배신으로 인정돼</small></div><button class="ib" data-ui="ally-break" data-to="${t.id}" ${isAlly ? '' : 'disabled'}>해제</button></div>`;
  h += `<div class="item-row"><div class="info"><b>🪝 갈고리로 훔치기</b><small>자원 최대 3개 · 갈고리 ${inv.hook}개${S.me.hookCd ? ` · 대기 ${S.me.hookCd}s` : ''}</small></div><button class="ib red" data-ui="hook" data-to="${t.id}" ${inv.hook < 1 || !near || S.me.hookCd ? 'disabled' : ''}>훔치기</button></div>`;
  h += `<div class="item-row"><div class="info"><b>🪤 함정 설치</b><small>내 자리에 설치 (${inv.trap}개). 동맹 중에 설치하고 → 동맹 해제 → 상대가 밟으면 배신 성공!</small></div><button class="ib" data-ui="trap" ${inv.trap < 1 ? 'disabled' : ''}>설치</button></div>`;
  h += `<div class="sub">😈 배신에 성공하면 +150점(최대 2번). 하지만 모두에게 공개되고 90초간 동맹을 맺을 수 없어!</div>`;
  return h;
}

function campHTML() {
