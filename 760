// ---------- 그리기 ----------
const cv = $('#cv'), ctx = cv.getContext('2d');
const mini = $('#mini'), mctx = mini.getContext('2d');
let vw = innerWidth, vh = innerHeight, dpr = 1;
function resize() {
  dpr = Math.min(2, window.devicePixelRatio || 1);
  vw = innerWidth; vh = innerHeight;
  cv.width = Math.round(vw * dpr); cv.height = Math.round(vh * dpr);
}
addEventListener('resize', resize);
addEventListener('orientationchange', () => setTimeout(resize, 200));
resize();

function rr(c, x, y, w, h, r) {
  c.beginPath();
  c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r);
  c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath();
}
function emo(c, ch, x, y, size) { c.font = `${size}px sans-serif`; c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillText(ch, x, y); }

let last = performance.now();
let tAnim = 0;
function frame(now) {
  const dt = Math.min(0.1, (now - last) / 1000); last = now; tAnim += dt;
  if (playing && S && cfg) { try { draw(dt); } catch (e) { console.error(e); } }
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

function draw(dt) {
  const k = 1 - Math.exp(-dt * 14);
  for (const q of pos.values()) { q.x += (q.tx - q.x) * k; q.y += (q.ty - q.y) * k; }
  const me = meP();
  const alive = me && me.a;
  let focus = pos.get(pid);
  if (!alive) {
    if (!specPid || !pos.get(specPid)) { const a = S.players.find((p) => p.a && pos.get(p.id)); specPid = a ? a.id : null; }
    focus = specPid ? pos.get(specPid) : null;
  }
  if (focus) { cam.x += (focus.x - cam.x) * Math.min(1, dt * 10); cam.y += (focus.y - cam.y) * Math.min(1, dt * 10); }
  const sc = Math.max(0.55, Math.min(1.4, Math.min(vw, vh) / 560));
  const { W, H, CAMP, DOCK, zones } = cfg;

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#6fd3f2'; ctx.fillRect(0, 0, vw, vh);
  ctx.save();
  ctx.translate(vw / 2 - cam.x * sc, vh / 2 - cam.y * sc);
  ctx.scale(sc, sc);

  // 바다 물결
  ctx.strokeStyle = 'rgba(255,255,255,.35)'; ctx.lineWidth = 3;
  for (let i = 0; i < 14; i++) {
    const wx = ((i * 337) % (W + 600)) - 300, wy = ((i * 211) % (H + 600)) - 300 + Math.sin(tAnim + i) * 6;
    ctx.beginPath(); ctx.arc(wx, wy, 26, Math.PI * 1.1, Math.PI * 1.9); ctx.stroke();
  }
  // 섬
  ctx.fillStyle = '#f6e7b0'; rr(ctx, -22, -22, W + 44, H + 44, 120); ctx.fill();
  ctx.fillStyle = '#c9f0a3'; rr(ctx, 0, 0, W, H, 100); ctx.fill();
  for (const key of Object.keys(zones)) {
    const z = zones[key];
    ctx.fillStyle = ZONE_COLOR[key]; rr(ctx, z.x, z.y, z.w, z.h, key === 'hazard' ? 60 : 80); ctx.fill();
    ctx.globalAlpha = 0.22; emo(ctx, z.emoji, z.x + z.w / 2, z.y + z.h / 2, 150); ctx.globalAlpha = 1;
    ctx.fillStyle = 'rgba(70,50,110,.55)'; ctx.font = 'bold 26px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(z.name, z.x + z.w / 2, z.y + 34);
  }
  if (S.volcano) { ctx.fillStyle = 'rgba(255,70,0,.35)'; const z = zones.hazard; rr(ctx, z.x - 150, z.y - 150, z.w + 300, z.h + 300, 120); ctx.fill(); }
  // 캠프
  ctx.fillStyle = '#ffe9b8'; ctx.beginPath(); ctx.arc(CAMP.x, CAMP.y, 150, 0, 7); ctx.fill();
  ctx.strokeStyle = '#ffb347'; ctx.lineWidth = 5; ctx.stroke();
  ctx.setLineDash([14, 12]); ctx.strokeStyle = 'rgba(46,160,90,.7)'; ctx.lineWidth = 4;
  ctx.beginPath(); ctx.arc(CAMP.x, CAMP.y, S.camp.safe, 0, 7); ctx.stroke(); ctx.setLineDash([]);
  emo(ctx, '🏕️', CAMP.x, CAMP.y - 6, 70);
  ctx.fillStyle = '#6b3fd1'; ctx.font = 'bold 22px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(`캠프 Lv.${S.camp.lv}`, CAMP.x, CAMP.y + 56);
  // 선착장
  emo(ctx, S.ship.active ? '🚢' : '⚓', DOCK.x, DOCK.y, 64);
  ctx.fillStyle = '#2f8ad0'; ctx.font = 'bold 20px sans-serif'; ctx.fillText(S.ship.active ? `탈출선 ${S.ship.boarded}/${S.ship.seats}` : '선착장', DOCK.x, DOCK.y + 48);

  // 함정
  for (const t of S.traps) { ctx.globalAlpha = 0.9; emo(ctx, '🪤', t.x, t.y, 30); ctx.globalAlpha = 1; }
  // 자원
  const pad = 60;
  const x0 = cam.x - vw / 2 / sc - pad, x1 = cam.x + vw / 2 / sc + pad, y0 = cam.y - vh / 2 / sc - pad, y1 = cam.y + vh / 2 / sc + pad;
  for (const n of nodes) {
    if (n[2] < x0 || n[2] > x1 || n[3] < y0 || n[3] > y1) continue;
    if (n[1] === 'chest' || n[1] === 'gem') { ctx.fillStyle = 'rgba(255,240,120,.55)'; ctx.beginPath(); ctx.arc(n[2], n[3], 24 + Math.sin(tAnim * 4) * 3, 0, 7); ctx.fill(); }
    emo(ctx, NODE_E[n[1]], n[2], n[3], n[1] === 'wood' ? 40 : 32);
  }
  // 운석 경고
  for (const m of S.meteors) {
    ctx.fillStyle = `rgba(255,60,60,${0.18 + 0.15 * Math.sin(tAnim * 12)})`; ctx.beginPath(); ctx.arc(m.x, m.y, 70, 0, 7); ctx.fill();
    ctx.strokeStyle = '#e0243f'; ctx.lineWidth = 4; ctx.stroke();
    emo(ctx, '☄️', m.x, m.y - Math.max(0, m.left) * 60, 40);
  }
  for (const b of S.boars) emo(ctx, '🐗', b.x, b.y, 44);

  // 플레이어
  const list = S.players.filter((p) => p.a && pos.get(p.id)).sort((a, b) => pos.get(a.id).y - pos.get(b.id).y);
  for (const p of list) {
    const q = pos.get(p.id);
    if (p.al) { ctx.strokeStyle = '#2ea05a'; ctx.lineWidth = 4; ctx.beginPath(); ctx.arc(q.x, q.y, 28, 0, 7); ctx.stroke(); }
    if (p.id === pid) { ctx.fillStyle = 'rgba(255,255,255,.5)'; ctx.beginPath(); ctx.arc(q.x, q.y + 4, 27, 0, 7); ctx.fill(); }
    if (p.sh) { ctx.fillStyle = 'rgba(90,184,255,.35)'; ctx.strokeStyle = '#5ab8ff'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(q.x, q.y, 34, 0, 7); ctx.fill(); ctx.stroke(); }
    emo(ctx, p.e, q.x, q.y, 42);
    ctx.font = 'bold 15px sans-serif'; ctx.textAlign = 'center';
    const label = `${p.bt ? '😈' : ''}${p.n}`;
    ctx.lineWidth = 4; ctx.strokeStyle = 'rgba(255,255,255,.9)'; ctx.strokeText(label, q.x, q.y - 40);
    ctx.fillStyle = p.bt ? '#d4193f' : '#3b3355'; ctx.fillText(label, q.x, q.y - 40);
    ctx.fillStyle = '#ffd9e3'; ctx.fillRect(q.x - 20, q.y + 26, 40, 5);
    ctx.fillStyle = '#ff6f9b'; ctx.fillRect(q.x - 20, q.y + 26, 40 * p.hp / 100, 5);
  }
  ctx.restore();

  // 날씨 오버레이
  if (S.ev) {
    const t = S.ev.type;
    const tint = { storm: 'rgba(60,70,95,.28)', rain: 'rgba(70,110,170,.2)', fog: 'rgba(255,255,255,.4)', volcano: 'rgba(255,80,20,.12)' }[t];
    if (tint) { ctx.fillStyle = tint; ctx.fillRect(0, 0, vw, vh); }
    if (t === 'rain' || t === 'storm') {
      ctx.strokeStyle = 'rgba(255,255,255,.55)'; ctx.lineWidth = 2; ctx.beginPath();
      for (let i = 0; i < 70; i++) { const rx = ((i * 97 + tAnim * 500) % (vw + 100)), ry = ((i * 53 + tAnim * 900) % vh); ctx.moveTo(rx, ry); ctx.lineTo(rx - 8, ry + 22); }
      ctx.stroke();
    }
  }
  // 밤 / 안개 시야 제한
  if (alive) {
    const fog = S.ev && S.ev.type === 'fog';
    const night = S.phase === 'night';
    if (night || fog) {
      const R = (fog ? 170 : 220) * sc;
      const fx = vw / 2 + (pos.get(pid).x - cam.x) * sc, fy = vh / 2 + (pos.get(pid).y - cam.y) * sc;
      const g = ctx.createRadialGradient(fx, fy, R * 0.45, fx, fy, R);
      const col = fog && !night ? '215,225,235' : '8,12,45';
      g.addColorStop(0, `rgba(${col},0)`); g.addColorStop(1, `rgba(${col},${fog && !night ? 0.9 : 0.93})`);
      ctx.fillStyle = g; ctx.fillRect(0, 0, vw, vh);
    }
  }
  drawMini(me);
}

function drawMini(me) {
  const { W, H, CAMP, DOCK, zones } = cfg;
  const mw = mini.width, mh = mini.height, sx = mw / W, sy = mh / H;
  mctx.fillStyle = '#6fd3f2'; mctx.fillRect(0, 0, mw, mh);
  mctx.fillStyle = '#c9f0a3'; mctx.fillRect(2, 2, mw - 4, mh - 4);
  for (const key of Object.keys(zones)) { const z = zones[key]; mctx.fillStyle = ZONE_COLOR[key]; mctx.fillRect(z.x * sx, z.y * sy, z.w * sx, z.h * sy); }
  mctx.fillStyle = '#ffb347'; mctx.beginPath(); mctx.arc(CAMP.x * sx, CAMP.y * sy, 150 * sx, 0, 7); mctx.fill();
  mctx.fillStyle = '#2f8ad0'; mctx.fillRect(DOCK.x * sx - 3, DOCK.y * sy - 3, 6, 6);
  for (const m of S.meteors) { mctx.fillStyle = 'rgba(224,36,63,.8)'; mctx.beginPath(); mctx.arc(m.x * sx, m.y * sy, 4, 0, 7); mctx.fill(); }
  for (const p of S.players) {
    if (!p.a) continue;
    const q = pos.get(p.id); if (!q) continue;
    if (p.id !== pid && !p.al && me && me.a) continue;
    mctx.fillStyle = p.id === pid ? '#ffffff' : (p.al ? '#2ea05a' : '#8a6cf0');
    mctx.strokeStyle = '#3b3355'; mctx.lineWidth = 1;
    mctx.beginPath(); mctx.arc(q.x * sx, q.y * sy, p.id === pid ? 4 : 3, 0, 7); mctx.fill(); mctx.stroke();
  }
}

