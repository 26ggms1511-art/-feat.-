  const lv = S.camp.lv, inv = S.me.inv, pool = S.camp.pool;
  const eff = ['', '기본 캠프 (회복 2/초)', '체력 회복 속도 증가 (5/초)', '상점 활성화 (3개 → 1개 교환)', '안전지역 확대', '탈출선 활성화!'];
  let h = `<div class="chips"><span class="chip ok">현재 Lv.${lv}</span><span class="chip">${eff[lv]}</span></div>`;
  if (lv < 5) {
    const cost = cfg.campCost[lv + 1];
    h += `<h4>Lv.${lv + 1} 업그레이드 (${eff[lv + 1]})</h4><div class="chips">`;
    for (const k of Object.keys(cost)) h += `<span class="chip ${pool[k] >= cost[k] ? 'ok' : ''}">${RE[k]} ${pool[k]}/${cost[k]}</span>`;
    h += `</div><div class="sub">모든 재료가 모이면 자동으로 업그레이드! 모두에게 이득이야.</div>`;
  } else h += `<div class="sub">최고 레벨! 탈출선으로 가자 🚢</div>`;
  h += `<h4>자원 넣기 ${inCamp ? '' : '(캠프 안에서만 가능)'}</h4>`;
  for (const k of RES) {
    h += `<div class="item-row"><div class="info"><b>${RE[k]} ${RN[k]}</b><small>내 보유 ${inv[k]}</small></div>
      <button class="ib" data-ui="deposit" data-res="${k}" data-n="1" ${!inCamp || inv[k] < 1 ? 'disabled' : ''}>+1</button>
      <button class="ib" data-ui="deposit" data-res="${k}" data-n="5" ${!inCamp || inv[k] < 5 ? 'disabled' : ''}>+5</button></div>`;
  }
  if (lv >= 3) {
    h += `<h4>🛒 상점 (3개 → 1개 교환)</h4><div class="item-row"><select id="ex-from">${RES.map((k) => `<option value="${k}">${RE[k]} ${RN[k]} 3개</option>`).join('')}</select>→
      <select id="ex-to">${RES.map((k, i) => `<option value="${k}" ${i === 3 ? 'selected' : ''}>${RE[k]} ${RN[k]} 1개</option>`).join('')}</select>
      <button class="ib pink" data-ui="exchange" ${inCamp ? '' : 'disabled'}>교환</button></div>`;
  }
  return h;
}

