<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#7fd8f6">
<title>친구 배신 게임</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>

<!-- 메뉴 -->
<section id="screen-menu" class="screen">
  <div class="card menu-card">
    <div class="logo">🏝️😈</div>
    <h1>친구 배신 게임</h1>
    <p class="sub">협력할까? 배신할까? 마지막 탈출선은 자리가 모자라!</p>
    <input id="inp-name" maxlength="8" placeholder="내 이름 (8자까지)" autocomplete="off">
    <button id="btn-create" class="btn big">🎮 방 만들기</button>
    <div class="or">또는</div>
    <input id="inp-code" maxlength="5" placeholder="방 코드 5자리" autocomplete="off" autocapitalize="characters">
    <button id="btn-join" class="btn big alt">🚪 방 참가</button>
    <div id="menu-msg" class="msg"></div>
  </div>
</section>

<!-- 로비 -->
<section id="screen-lobby" class="screen hidden">
  <div class="card menu-card">
    <div class="sub">방 코드</div>
    <div id="lobby-code" class="code">-----</div>
    <div class="row">
      <button id="btn-copy" class="btn small">🔗 초대 링크 복사</button>
    </div>
    <h3>모인 친구들 <span id="lobby-count"></span></h3>
    <ul id="lobby-list" class="plist"></ul>
    <div id="lobby-msg" class="msg"></div>
    <button id="btn-start" class="btn big hidden">▶ 게임 시작</button>
    <div id="lobby-wait" class="sub hidden">방장이 시작하기를 기다리는 중...</div>
    <button id="btn-leave" class="btn small ghost">나가기</button>
  </div>
</section>

<!-- 게임 -->
<section id="screen-game" class="screen hidden">
  <canvas id="cv"></canvas>

  <div id="hud">
    <div class="hud-box">
      <div class="hp-wrap"><div id="hp-fill"></div><span id="hp-text">❤️ 100</span></div>
      <div class="hud-line"><span id="hud-phase">☀️</span> <span id="hud-time">11:00</span> · 방 <b id="hud-code">-----</b></div>
      <div class="hud-line">⭐ <b id="hud-score">0</b>점 · 🏕️ Lv.<b id="hud-camp">1</b></div>
      <div class="hud-line" id="res-line"></div>
    </div>
    <div id="event-banner" class="hidden"></div>
  </div>

  <canvas id="mini" width="132" height="88"></canvas>
  <div id="ship-info" class="hidden"></div>

  <div id="log"></div>
  <div id="reqs"></div>
  <div id="toasts"></div>

  <div id="joy"><div id="knob"></div></div>

  <div id="btns">
    <button class="rb" data-open="inv">🎒<span>가방</span></button>
    <button class="rb" data-open="players">👥<span>친구</span></button>
    <button class="rb" data-open="camp">🏕️<span>캠프</span></button>
    <button class="rb" data-open="mission">🎯<span>미션</span></button>
    <button class="rb" data-open="chat">💬<span>채팅</span></button>
    <button class="rb hidden" id="btn-spec">👁<span>관전</span></button>
  </div>
  <button id="btn-main" class="main-btn">🖐 채집</button>

  <div id="panel" class="panel hidden">
    <div class="panel-head"><span id="panel-title"></span><button class="x" data-close="1">✕</button></div>
    <div id="panel-body"></div>
  </div>
</section>

<!-- 결과 -->
<section id="screen-end" class="screen hidden">
  <div class="card menu-card wide">
    <div class="logo">🏆</div>
    <h1 id="end-title">게임 끝!</h1>
    <div id="end-winner" class="sub"></div>
    <div id="end-rows"></div>
    <button id="btn-rematch" class="btn big hidden">🔁 같은 방에서 다시 하기</button>
    <div id="end-wait" class="sub hidden">방장이 다시 시작하기를 기다리는 중...</div>
    <button id="btn-end-leave" class="btn small ghost">나가기</button>
  </div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script src="/game.js"></script>
</body>
</html>
